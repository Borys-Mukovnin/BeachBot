        <mxCell id="U25FvlGhTjq5Z8Q8Mhmu-39" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Authenticate&lt;/h1&gt;&lt;div&gt;API Schema&lt;/div&gt;&lt;p&gt;&quot;login&quot;: {&lt;br&gt;&amp;nbsp; &quot;_note&quot;: &quot;Password is SHA-256 hashed client-side. type is &#39;password&#39;.&quot;,&lt;br&gt;&amp;nbsp; &quot;request&quot;: {&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;msg&quot;: &quot;method&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;method&quot;: &quot;login&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;params&quot;: [&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; { &quot;user&quot;: { &quot;email&quot;: &quot;string&quot; }, &quot;password&quot;: { &quot;digest&quot;: &quot;sha256-hex-string&quot;, &quot;algorithm&quot;: &quot;sha-256&quot; } }&lt;br&gt;&amp;nbsp; &amp;nbsp; ],&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;id&quot;: &quot;string&quot;&lt;br&gt;&amp;nbsp; },&lt;br&gt;&amp;nbsp; &quot;response&quot;: {&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;id&quot;: &quot;SampleLoginId0001&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;token&quot;: &quot;EXAMPLE_RESUME_TOKEN&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;tokenExpires&quot;: { &quot;$date&quot;: 1789468270474 },&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;type&quot;: &quot;password&quot;&lt;br&gt;&amp;nbsp; }&lt;br&gt;}&lt;/p&gt;&lt;p&gt;It should be possible to save the credentials with &quot;Remember me&quot; button for next uses.&lt;/p&gt;" vertex="1">
          <mxGeometry height="410" width="310" x="-400" y="-200" as="geometry" />
        </mxCell>
        <mxCell id="U25FvlGhTjq5Z8Q8Mhmu-40" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Display tournaments&lt;/h1&gt;&lt;div&gt;API Schema&lt;/div&gt;&lt;p&gt;&quot;tournaments.list&quot;: {&lt;br&gt;&amp;nbsp; &quot;_note&quot;: &quot;Paged list. The tournament objects here are the LIGHT form (subset of getDetail). &#39;series&#39;/&#39;category&#39;/&#39;facility&#39; are ids; &#39;seriesLink&#39;/&#39;categoryLink&#39; embed names + gender constraint. gameDateTo present only for multi-day events.&quot;,&lt;br&gt;&amp;nbsp; &quot;request&quot;: {&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;msg&quot;: &quot;method&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;method&quot;: &quot;tournaments.list&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;params&quot;: [ { &quot;view&quot;: &quot;upcoming&quot;, &quot;limit&quot;: 100, &quot;skip&quot;: 0, &quot;userId&quot;: &quot;string|null&quot; } ],&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;id&quot;: &quot;string&quot;&lt;br&gt;&amp;nbsp; },&lt;br&gt;&amp;nbsp; &quot;response&quot;: {&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;tournaments&quot;: [&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;_id&quot;: &quot;SampleTournId0001&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;createdAt&quot;: { &quot;$date&quot;: 1779961640799 },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;series&quot;: &quot;h&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;category&quot;: &quot;b&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;facility&quot;: &quot;SampleFacility001&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;cityCache&quot;: &quot;Musterstadt&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;teamType&quot;: &quot;default&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;teamSize&quot;: 2,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;checkInDeadline&quot;: { &quot;$date&quot;: 1780912800000 },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;maxTeams&quot;: 9,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;gameDate&quot;: { &quot;$date&quot;: 1781690400000 },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;gameDateTo&quot;: { &quot;$date&quot;: 1781863200000 },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;technicalMeeting&quot;: { &quot;$date&quot;: 1779980429081 },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;teamCountCurrent&quot;: 10,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;teamCountApproved&quot;: 9,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;teamCountEndResults&quot;: 0,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;host&quot;: &quot;SampleHostId00001&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;state&quot;: &quot;approved&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;endResultsPublished&quot;: false,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;gamesPublished&quot;: true,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;publishedAt&quot;: { &quot;$date&quot;: 1779966864108 },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;seriesLink&quot;: { &quot;_id&quot;: &quot;h&quot;, &quot;name&quot;: &quot;Herren&quot;, &quot;teamConstraints&quot;: { &quot;gender&quot;: &quot;male&quot; } },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;categoryLink&quot;: { &quot;_id&quot;: &quot;b&quot;, &quot;name&quot;: &quot;B&quot; },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;resolvedName&quot;: &quot;Musterstadt&quot;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; &amp;nbsp; ],&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;tournamentsCount&quot;: 632&lt;br&gt;&amp;nbsp; }&lt;br&gt;}&lt;/p&gt;&lt;p&gt;Shows only tournaments where registration is not yet open. Relevant fields: if registered teams count is 0 or registration date is in the future&lt;/p&gt;&lt;p&gt;There should be filtering options by:&lt;/p&gt;&lt;p&gt;City - free input&lt;/p&gt;&lt;p&gt;Category - fixed dropbox options&lt;/p&gt;&lt;p&gt;Series - fixed dropbox options&lt;/p&gt;" vertex="1">
          <mxGeometry height="890" width="310" x="650" y="-470" as="geometry" />
        </mxCell>
        <mxCell id="U25FvlGhTjq5Z8Q8Mhmu-42" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Tournament Details&lt;/h1&gt;&lt;div&gt;API Schema&lt;/div&gt;&quot;tournament.getDetail&quot;: {  &quot;_note&quot;: &quot;Full tournament plus related lookup&lt;br/&gt; objects. &#39;series&#39;/&#39;category&#39; are the resolved objects for this &lt;br/&gt;tournament; &#39;allSeries&#39;/&#39;allCategories&#39; are the valid options. &lt;br/&gt;&#39;facility&#39; is double-wrapped (Astronomy/$value.values is a JSON STRING &lt;br/&gt;that must be parsed again). &#39;checkInStartDeadline&#39; is when REGISTRATION &lt;br/&gt;OPENS.&quot;,  &quot;request&quot;: {    &quot;msg&quot;: &quot;method&quot;,    &quot;method&quot;: &lt;br/&gt;&quot;tournament.getDetail&quot;,    &quot;params&quot;: [ &quot;tournamentId&quot; ],    &quot;id&quot;: &lt;br/&gt;&quot;string&quot;  },  &quot;response&quot;: {    &quot;tournament&quot;: {      &quot;_id&quot;: &lt;br/&gt;&quot;SampleTournId0001&quot;,      &quot;series&quot;: &quot;h&quot;,      &quot;category&quot;: &quot;b&quot;,      &lt;br/&gt;&quot;facility&quot;: &quot;SampleFacility001&quot;,      &quot;cityCache&quot;: &quot;Musterstadt&quot;,      &lt;br/&gt;&quot;relatedTournaments&quot;: [],      &quot;relatedTournamentsSharePrize&quot;: false,   &lt;br/&gt;   &quot;teamType&quot;: &quot;default&quot;,      &quot;teamSize&quot;: 2,      &quot;admissionFee&quot;: 33,  &lt;br/&gt;    &quot;admissionFeeEarly&quot;: 28,      &quot;prize&quot;: 60,      &quot;scoreDistribution&quot;:&lt;br/&gt; { &quot;8&quot;: [48, 40, 32, 24, 16, 16, 8, 8] },      &quot;scoreMode&quot;: &lt;br/&gt;&quot;by_actual_teams&quot;,      &quot;checkInStartDeadline&quot;: { &quot;$date&quot;: 1780246800000&lt;br/&gt; },      &quot;checkInDeadline&quot;: { &quot;$date&quot;: 1780912800000 },      &lt;br/&gt;&quot;checkInDeadlineAuto&quot;: true,      &quot;seedingDeadline&quot;: { &quot;$date&quot;: &lt;br/&gt;1781517600000 },      &quot;seedingDeadlineAuto&quot;: true,      &lt;br/&gt;&quot;wildcardDeadline&quot;: { &quot;$date&quot;: 1780912800000 },      &lt;br/&gt;&quot;wildcardDeadlineAuto&quot;: true,      &quot;allocationDeadline&quot;: { &quot;$date&quot;: &lt;br/&gt;1780999200000 },      &quot;allocationDeadlineAuto&quot;: true,      &lt;br/&gt;&quot;finalCheckInDeadline&quot;: { &quot;$date&quot;: 1781589600000 },      &lt;br/&gt;&quot;finalCheckInDeadlineAuto&quot;: true,      &quot;finalCheckOutDeadline&quot;: null,   &lt;br/&gt;   &quot;freezeDeadline&quot;: { &quot;$date&quot;: 1781632800000 },      &lt;br/&gt;&quot;freezeDeadlineAuto&quot;: true,      &quot;maxTeams&quot;: 9,      &quot;courtCount&quot;: 3,   &lt;br/&gt;   &quot;gameDate&quot;: { &quot;$date&quot;: 1781690400000 },      &quot;technicalMeeting&quot;: { &lt;br/&gt;&quot;$date&quot;: 1779980429081 },      &quot;teamCountCurrent&quot;: 10,      &lt;br/&gt;&quot;teamCountApproved&quot;: 9,      &quot;teamCountEndResults&quot;: 0,      &lt;br/&gt;&quot;suggestionComment&quot;: &quot;Turnierbeginn 17:15 Uhr.\n...&quot;,      &quot;dvv&quot;: {},   &lt;br/&gt;   &quot;host&quot;: &quot;SampleHostId00001&quot;,      &quot;additionalHosts&quot;: [],      &lt;br/&gt;&quot;admissionAllocation&quot;: {        &quot;wildcardsHost&quot;: 1,        &lt;br/&gt;&quot;wildcardsHostAuto&quot;: true,        &quot;wildcardsHostAdmissionConstraints&quot;: &lt;br/&gt;true,        &quot;wildcardsOrganization&quot;: 0,        &quot;wildcardsDvv&quot;: 0,      &lt;br/&gt;  &quot;byDvvPoints&quot;: 0,        &quot;byRegistrationDate&quot;: -1,        &lt;br/&gt;&quot;byWvvPoints&quot;: 0,        &quot;byQualification&quot;: 0      },      &lt;br/&gt;&quot;qualificationMaxTeams&quot;: 0,      &quot;qualificationTournamentAllocation&quot;: { &lt;br/&gt;       &quot;wildcardsHost&quot;: 0,        &quot;wildcardsHostAuto&quot;: true,        &lt;br/&gt;&quot;wildcardsHostAdmissionConstraints&quot;: false,        &lt;br/&gt;&quot;wildcardsOrganization&quot;: 0,        &quot;wildcardsDvv&quot;: 0,        &lt;br/&gt;&quot;byDvvPoints&quot;: 0,        &quot;byRegistrationDate&quot;: -1,        &quot;byWvvPoints&quot;:&lt;br/&gt; 0,        &quot;byQualification&quot;: 0      },      &quot;dvvFactor&quot;: 0,      &lt;br/&gt;&quot;state&quot;: &quot;approved&quot;,      &quot;seedsPublished&quot;: true,      &quot;seedsFrozen&quot;: &lt;br/&gt;true,      &quot;allocationPublished&quot;: true,      &quot;allocationModified&quot;: &lt;br/&gt;false,      &quot;allocationSimulationPublished&quot;: false,      &lt;br/&gt;&quot;registrationsHidden&quot;: false,      &quot;endResultsPublished&quot;: false,      &lt;br/&gt;&quot;endResultsModified&quot;: false,      &quot;endResultsPricesModified&quot;: false,    &lt;br/&gt;  &quot;gamesPublished&quot;: true,      &quot;addReferees&quot;: false,      &lt;br/&gt;&quot;allowPlayerScoreSubmission&quot;: true,      &quot;games&quot;: { &quot;results&quot;: [ { &lt;br/&gt;&quot;score&quot;: [], &quot;setResults&quot;: [], &quot;extra&quot;: &quot;Feld 4&quot; } ] },      &lt;br/&gt;&quot;paymentsFinalized&quot;: false,      &quot;paymentsExported&quot;: false,      &lt;br/&gt;&quot;paymentsCreditExported&quot;: false,      &quot;paymentsHostExported&quot;: false,    &lt;br/&gt;  &quot;gameMode&quot;: &quot;poolPlay9Sing&quot;,      &quot;additionalRankingSeries&quot;: {},      &lt;br/&gt;&quot;publishedAt&quot;: { &quot;$date&quot;: 1779966864108 }    },    &quot;series&quot;: {      &lt;br/&gt;&quot;_id&quot;: &quot;h&quot;,      &quot;name&quot;: &quot;Herren&quot;,      &quot;priority&quot;: 10,      &quot;active&quot;: &lt;br/&gt;true,      &quot;dvvIds&quot;: { &quot;2025&quot;: 302, &quot;2026&quot;: 336 },      &quot;categoriesIds&quot;:&lt;br/&gt; [&quot;m&quot;, &quot;p&quot;, &quot;a-plus&quot;, &quot;a&quot;, &quot;b&quot;, &quot;b-plus&quot;, &quot;b-finale&quot;, &quot;c&quot;, &quot;c-finale&quot;, &lt;br/&gt;&quot;d&quot;, &quot;0&quot;, &quot;w&quot;],      &quot;teamConstraints&quot;: { &quot;gender&quot;: &quot;male&quot; }    },    &lt;br/&gt;&quot;category&quot;: {      &quot;_id&quot;: &quot;b&quot;,      &quot;name&quot;: &quot;B&quot;,      &quot;priority&quot;: 0,    &lt;br/&gt;  &quot;admissionFee&quot;: 33,      &quot;admissionFeeEarly&quot;: 28,      &quot;hostFee&quot;: 800,&lt;br/&gt;      &quot;minimumTeams&quot;: 6,      &quot;prizeMinimum&quot;: { &quot;8&quot;: 225, &quot;12&quot;: 340, &lt;br/&gt;&quot;16&quot;: 450, &quot;20&quot;: 560, &quot;24&quot;: 675 },      &quot;scoreDistribution&quot;: { &quot;8&quot;: [48,&lt;br/&gt; 40, 32, 24, 16, 16, 8, 8] },      &quot;prizeDistribution&quot;: { &quot;20&quot;: [50, 30,&lt;br/&gt; 20], &quot;64&quot;: [40, 30, 20, 10] },      &quot;qualificationTournament&quot;: true,   &lt;br/&gt;   &quot;checkInDeadline&quot;: { &quot;daysBefore&quot;: 8, &quot;dayOfTheWeek&quot;: 1, &quot;time&quot;: 12 &lt;br/&gt;},      &quot;allocationDeadline&quot;: { &quot;daysBefore&quot;: 8, &quot;dayOfTheWeek&quot;: 2, &lt;br/&gt;&quot;time&quot;: 12 },      &quot;seedingDeadline&quot;: { &quot;daysBefore&quot;: 1, &quot;dayOfTheWeek&quot;:&lt;br/&gt; 1, &quot;time&quot;: 12 },      &quot;wildcardDeadline&quot;: { &quot;daysBefore&quot;: 8, &lt;br/&gt;&quot;dayOfTheWeek&quot;: 1, &quot;time&quot;: 12 },      &quot;finalCheckInDeadline&quot;: { &lt;br/&gt;&quot;daysBefore&quot;: 1, &quot;dayOfTheWeek&quot;: null, &quot;time&quot;: 8 },      &lt;br/&gt;&quot;admissionAllocation&quot;: {        &quot;wildcardsOrganization&quot;: 0,        &lt;br/&gt;&quot;byDvvPoints&quot;: 0,        &quot;byWvvPoints&quot;: 0,        &quot;byRegistrationDate&quot;: &lt;br/&gt;-1,        &quot;wildcardsHost&quot;: 0,        &quot;wildcardsHostAuto&quot;: true,        &lt;br/&gt;&quot;wildcardsHostAdmissionConstraints&quot;: true      },      &quot;mode&quot;: [&quot;Double &lt;br/&gt;Out&quot;],      &quot;isPopular&quot;: true,      &quot;freezeDeadline&quot;: { &quot;daysBefore&quot;: 1,&lt;br/&gt; &quot;time&quot;: 20 }    },    &quot;allSeries&quot;: [ &quot;&amp;lt;same shape as series &lt;br/&gt;above&amp;gt;&quot; ],    &quot;allCategories&quot;: [ &quot;&amp;lt;same shape as category &lt;br/&gt;above&amp;gt;&quot; ],    &quot;facility&quot;: {      &quot;_comment&quot;: &quot;Astronomy-wrapped; &lt;br/&gt;$value.values is a JSON STRING that must be parsed again to get the &lt;br/&gt;Facility. Nested location/gpsCoordinate are wrapped the same way.&quot;,     &lt;br/&gt; &quot;$type&quot;: &quot;Astronomy&quot;,      &quot;$value&quot;: {        &quot;class&quot;: &quot;Facility&quot;,     &lt;br/&gt;   &quot;values&quot;: &quot;{\&quot;_id\&quot;:\&quot;SampleFacility001\&quot;,\&quot;title\&quot;:\&quot;Sample &lt;br/&gt;TV\&quot;,\&quot;courtCount\&quot;:3,\&quot;publicAccess\&quot;:true,\&quot;location\&quot;:{\&quot;...\&quot;:\&quot;nested&lt;br/&gt; Astronomy-wrapped Location with street, houseNumber, zipCode, city, &lt;br/&gt;formattedAddress, gpsCoordinate\&quot;}}&quot;,        &quot;isNew&quot;: true      }    }, &lt;br/&gt;   &quot;gameMode&quot;: { &quot;_id&quot;: &quot;poolPlay9Sing&quot;, &quot;name&quot;: &quot;9 Pool Play&quot;, &lt;br/&gt;&quot;hasTree&quot;: true },    &quot;resolvedHost&quot;: {      &quot;isAdmin&quot;: false,      &lt;br/&gt;&quot;_id&quot;: &quot;SampleHostId00001&quot;,      &quot;name&quot;: &quot;Beachvolleyball Sample &lt;br/&gt;TV&quot;,      &quot;club&quot;: &quot;Sample TV v. 1879 e.V.&quot;,      &quot;email&quot;: &lt;br/&gt;&quot;kontakt@example.com&quot;,      &quot;phone&quot;: &quot;+49 000 0000000&quot;    }  }}," vertex="1">
          <mxGeometry height="890" width="310" x="1150" y="-480" as="geometry" />
        </mxCell>
        <mxCell id="U25FvlGhTjq5Z8Q8Mhmu-43" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Choose a player&lt;/h1&gt;&lt;div&gt;API Schema&lt;/div&gt;&quot;users.searchPlayers&quot;: {&lt;br&gt;&amp;nbsp; &quot;_note&quot;: &quot;Flat list ranked by fuzzy &#39;score&#39; (higher = better). profile here is minimal: firstName/lastName and sometimes clubCache. The _id is the partnerId used to register.&quot;,&lt;br&gt;&amp;nbsp; &quot;request&quot;: {&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;msg&quot;: &quot;method&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;method&quot;: &quot;users.searchPlayers&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;params&quot;: [ &quot;searchText&quot;, { &quot;showUnverified&quot;: false, &quot;series&quot;: &quot;string|null&quot; } ],&lt;br&gt;&amp;nbsp; &amp;nbsp; &quot;id&quot;: &quot;string&quot;&lt;br&gt;&amp;nbsp; },&lt;br&gt;&amp;nbsp; &quot;response&quot;: [&lt;br&gt;&amp;nbsp; &amp;nbsp; {&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;_id&quot;: &quot;SamplePlayerId005&quot;,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;profile&quot;: { &quot;firstName&quot;: &quot;Chris&quot;, &quot;lastName&quot;: &quot;Muster&quot;, &quot;clubCache&quot;: &quot;Sample SV 1905 e.V.&quot; },&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;score&quot;: 11.625&lt;br&gt;&amp;nbsp; &amp;nbsp; }&lt;br&gt;&amp;nbsp; ]&lt;br&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Filter options by Name/Surname (as a single input field, same scores from api can be used). Should also have a list of player&#39;s from past registrations with option to remove them from past list &quot;through an x near the name&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="460" width="310" x="-400" y="230" as="geometry" />
        </mxCell>
        <mxCell id="U25FvlGhTjq5Z8Q8Mhmu-44" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Display confirmation&lt;/h1&gt;&lt;div&gt;Displays all relevant information about the registration to schedule. Should be explicitly confirmed&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="640" y="440" as="geometry" />
        </mxCell>
        <mxCell id="U25FvlGhTjq5Z8Q8Mhmu-45" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Main menu&lt;/h1&gt;&lt;div&gt;Shows all current scheduled registrations&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Shows all past registration through this app&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Button to create new registration.&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="310" x="90" y="-160" as="geometry" />
        </mxCell>
      </root>
