  "tournament.registration": {
    "_note": "THE WRITE CALL. Self-registers the logged-in user + partner. You are implicit; only the partnerId is passed. On success returns a result (not yet captured against a successful run); on failure the DDP message carries an 'error' object with German 'reason' text (e.g. license missing, already registered, not open yet). 'tournament.addRegistration' (tournamentId, p1, p2) is the admin-only 3-arg variant and returns 403 for normal players.",
    "request": {
      "msg": "method",
      "method": "tournament.registration",
      "params": [ "tournamentId", "partnerId" ],
      "id": "string"
    },
    "response": { "_unknown": "Not captured — a real successful registration has intentionally not been run." },
    "errorShape": {
      "msg": "result",
      "id": "string",
      "error": { "error": 403, "reason": "string (German)", "message": "string", "errorType": "Meteor.Error" }
    }
  }
