{
  "_about": "DDP (Meteor) API for beachvolleyball.nrw. Each entry describes one WebSocket method: its request (the DDP 'method' message) and a representative response. All values in the examples are SYNTHETIC sample data — use the response shapes as a base for DTOs. Endpoint: wss://www.beachvolleyball.nrw/websocket.",
  "_conventions": {
    "transport": "DDP over raw WebSocket. A call is sent as {\"msg\":\"method\",\"method\":<name>,\"params\":[...],\"id\":<string>} and the reply is {\"msg\":\"result\",\"id\":<same>,\"result\":<payload>} or {\"msg\":\"result\",\"id\":<same>,\"error\":{...}}.",
    "ejsonDate": "All timestamps are EJSON-wrapped: {\"$date\": <unixMillis:int>}. Model as a value object / epoch-millis long.",
    "ids": "All _id fields are Meteor random strings (17 chars), e.g. 'SampleTournId0001'. Series/category ids are short slugs ('h','m','b','d').",
    "nullable": "Fields shown with null in examples are nullable. Date fields can also be null. rankings maps may be empty.",
    "maps": "scoreDistribution / prizeDistribution / prizeMinimum / dvvIds are objects keyed by a STRING (bracket size or year) -> value. rankings is keyed by series-id -> ranking object.",
    "germanText": "String content may contain German text and umlauts (UTF-8)."
  },

  "connect": {
    "_note": "Handshake, not a method call. Sent once after the socket opens.",
    "request": { "msg": "connect", "version": "1", "support": ["1", "pre2", "pre1"] },
    "response": { "msg": "connected", "session": "string-session-id" }
  },

  "login": {
    "_note": "Password is SHA-256 hashed client-side. type is 'password'.",
    "request": {
      "msg": "method",
      "method": "login",
      "params": [
        { "user": { "email": "string" }, "password": { "digest": "sha256-hex-string", "algorithm": "sha-256" } }
      ],
      "id": "string"
    },
    "response": {
      "id": "SampleLoginId0001",
      "token": "EXAMPLE_RESUME_TOKEN",
      "tokenExpires": { "$date": 1789468270474 },
      "type": "password"
    }
  },

  "tournaments.list": {
